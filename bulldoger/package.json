{
  "name": "bulldoger",
  "private": true,
  "version": "0.1.0",
  "description": "Bulldoger: a swipe-to-pay platform where donors bulldoge verified people's bills, paid straight to the creditor.",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:web": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace shared",
    "start": "npm start --workspace server",
    "heroku-postbuild": "VITE_API_URL=/ npm run build --workspace web"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
